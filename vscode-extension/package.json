{
  "name": "inoc-lang",
  "displayName": "i-noc language plugin",
  "description": "Official support for the I-NOC programming language: native intention-oriented code.",
  "version": "1.4.2",
  "publisher": "inoc-tools",
  "license": "Apache-2.0",
  "homepage": "https://github.com/i-noc/inoc",
  "repository": {
    "type": "git",
    "url": "https://github.com/i-noc/inoc",
    "directory": "vscode-extension"
  },
  "bugs": "https://github.com/i-noc/inoc/issues",
  "icon": "images/inoc-logo.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "inoc",
    "programming-language",
    "intelli-sense",
    "ui"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:inoc"
  ],
  "contributes": {
    "languages": [
      {
        "id": "inoc",
        "aliases": [
          "I-NOC",
          "INOC",
          "inoc"
        ],
        "extensions": [
          ".inoc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "inoc",
        "scopeName": "source.inoc",
        "path": "./syntaxes/inoc.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "inoc",
        "path": "./snippets/inoc.json"
      }
    ],
    "commands": [
      {
        "command": "inoc.runFile",
        "title": "I-NOC: Run File",
        "category": "I-NOC"
      }
    ],
    "configuration": {
      "title": "I-NOC",
      "properties": {
        "inoc.runtimePath": {
          "type": "string",
          "default": "",
          "description": "Caminho absoluto para o executável 'inoc-runtime' da linguagem I-NOC. Se vazio, a extensão tentará localizá-lo automaticamente."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "when": "resourceExtname == '.inoc'",
          "command": "inoc.runFile",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "glob": "^8.0.3",
    "mocha": "^10.1.0",
    "typescript": "^4.9.3",
    "@vscode/test-electron": "^2.2.0"
  },
  "dependencies": {
    "vscode-languageclient": "^8.0.2"
  }
}
