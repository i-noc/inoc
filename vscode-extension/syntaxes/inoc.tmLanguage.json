{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "I-NOC",
  "scopeName": "source.inoc",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#ui_reference"
    },
    {
      "include": "#ui_elements"
    },
    {
      "include": "#structure_symbols"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-tilde.inoc",
          "match": "~~.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.inoc",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.inoc",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.inoc",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.inoc",
          "match": "\\b(if|else|and|or|not)\\b"
        },
        {
          "name": "constant.language.boolean.inoc",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "ui_reference": {
      "patterns": [
        {
          "name": "meta.ui.reference.inoc",
          "match": "(\\|)([a-zA-Z_][a-zA-Z0-9_]*)(\\|)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.inoc" },
            "2": { "name": "entity.name.tag.reference.inoc" },
            "3": { "name": "punctuation.definition.tag.inoc" }
          }
        }
      ]
    },
    "ui_elements": {
      "patterns": [
        {
          "name": "meta.ui.declaration.inoc",
          "begin": "(/[:+])|(\\|)",
          "beginCaptures": {
            "1": { "name": "entity.name.tag.structure.inoc" },
            "2": { "name": "punctuation.definition.tag.inoc" }
          },
          "end": "(\\|)|$",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.inoc" }
          },
          "patterns": [
            {
              "name": "variable.other.property.inoc",
              "match": "#\\s*[a-zA-Z_][a-zA-Z0-9_]*"
            },
            {
              "include": "#strings"
            }
          ]
        },
        {
          "name": "entity.name.tag.container.inoc",
          "match": "¢"
        },
        {
          "name": "entity.name.tag.object.inoc",
          "match": "//"
        }
      ]
    },
    "structure_symbols": {
      "patterns": [
        { "name": "keyword.control.conditional.inoc", "match": "\\?" },
        { "name": "keyword.control.else.inoc", "match": "£" },
        { "name": "keyword.control.loop.inoc", "match": "&:?" },
        { "name": "keyword.other.io.inoc", "match": "![^=]|@:?" },
        { "name": "keyword.declaration.function.inoc", "match": "\\$" },
        { "name": "keyword.control.return.inoc", "match": "\\$:" },
        { "name": "keyword.declaration.module.inoc", "match": "§" },
        { "name": "variable.other.property.inoc", "match": "#" }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.inoc",
          "match": "\\b(tamanho|texto|inserir|remover|tipo|subtexto|procurar|chaves|arredondar|absoluto|definir|numero)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.assignment.inoc", "match": "=" },
        { "name": "keyword.operator.comparison.inoc", "match": "==|!=|>=|<=|>|<" },
        { "name": "keyword.operator.arithmetic.inoc", "match": "\\+|\\-|\\*|/" },
        { "name": "keyword.operator.navigation.inoc", "match": "=>" },
        { "name": "punctuation.accessor.inoc", "match": "\\." },
        { "name": "punctuation.separator.inoc", "match": "," }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.inoc",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
